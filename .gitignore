# ---------------------------------------------------------------------------
# Draw on Web — .gitignore
# Keep the repo to just the shippable extension: manifest.json, README.md,
# LICENSE, and everything under src/. Everything below is local-only noise that
# should never be pushed.
# ---------------------------------------------------------------------------

# Local tooling / AI assistant config (machine-specific, not part of the product)
.claude/
.cursor/
.windsurf/
.idea/
.vscode/
*.code-workspace

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs & temp files
*.log
*.tmp
*.bak
*~

# Environment / secrets
.env
.env.*

# Node (only relevant if build tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output / packaged extension
dist/
build/
web-ext-artifacts/
*.zip
*.crx
*.pem

# Generated project documentation (local-only; not part of the shipped product)
*.pdf
